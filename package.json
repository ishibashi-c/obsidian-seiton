{
  "name": "seiton",
  "version": "0.1.0",
  "description": "Seiton - Capture & Organize: all-in-one Obsidian plugin",
  "keywords": [
    "obsidian",
    "plugin",
    "capture",
    "organize"
  ],
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "harness": "vite --config harness/vite.config.ts",
    "harness:build": "vite build --config harness/vite.config.ts",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "release:check": "npm run lint && npm test && npm run build && npm run harness:build && node scripts/check-release.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4",
    "ultracite": "^7.10.7",
    "vite": "^5.4.21",
    "vitest": "^2.0.5",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
